{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git merge-tree:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git remote:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push origin feature/:*)",
      "Bash(gh pr:*)",
      "Bash(gh auth status:*)",
      "Bash(python -m venv:*)",
      "Bash(.venv/Scripts/python -m pip install:*)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(curl -s -o /dev/null -w %{http_code} https://textile-records.onrender.com/:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(backend/.env)",
      "Read(backend/data/**)",
      "Edit(backend/data/**)",
      "Write(backend/data/**)",
      "Edit(backend/.env)",
      "Write(backend/.env)"
    ]
  }
}
