# Copy this file to ".env" (same folder) and fill in the values.
# The real .env is not saved in git, so your password stays private.

# ---- Database ----
# Leave empty to use the local SQLite file (backend/data/textile.db).
# For an online PostgreSQL, paste the connection string from your provider:
#   Neon:     Dashboard -> Connect -> pick the "Pooled connection" string
#             postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Supabase: Project -> Connect -> "Session pooler" string
#             postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# If the password has special characters (@ : / # ? &), URL-encode them (e.g. @ -> %40).
DATABASE_URL=

# Connections kept open to the online database (ignored for SQLite).
# Free plans allow few connections; the defaults below are safe.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- Folders (optional) ----
# Where backups (and the SQLite file, if used) are stored. Default: backend/data
TEXTILE_DATA_DIR=
# Folder of the built screens (frontend "npm run build" output). Default: frontend/dist
TEXTILE_UI_DIR=

# ---- Security ----
# Set a password when the app is hosted online; the browser asks for it once.
# Leave APP_PASSWORD empty for no login (fine on your own computer).
APP_USERNAME=admin
APP_PASSWORD=

# Websites allowed to call the API from a browser, comma separated.
# "*" allows any. When hosting online, set your site address, e.g. https://records.example.com
CORS_ORIGINS=*
